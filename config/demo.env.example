# Save as demo.env, edit the values for this host, then run: source demo.env
# Everything below is read by scripts/*.sh. Optional lines stay commented out.

# --- Spark ---
export SPARK_MASTER='spark://172.31.0.2:7077'
export SPARK_MYSQL_JAR="$HOME/jars/mysql-connector-java-8.0.33.jar"
# export DEMO_SPARK_SUBMIT='/data/spark/spark-2.4.3-bin-hadoop2.7/bin/spark-submit'

# --- Python ---
# Spark 2.4.3 only supports Python 3.4-3.7; the host's system Python is newer.
# Use a source-built 3.7 rather than the host Python.
export PYSPARK_PYTHON='/data/spark-python37/bin/python3'
export PYSPARK_DRIVER_PYTHON="$PYSPARK_PYTHON"
# MLlib needs NumPy. It lives in its own site dir; scripts/run.sh forwards this
# PYTHONPATH to executors through spark.executorEnv.PYTHONPATH. Adjust if your
# checkout is not /data/spark-project-fund-mlnew.
export PYTHONPATH='/data/spark-project-fund-mlnew/py37-site'
# Only used to build the module ZIP and to stream the dataset import; any Python 3 works.
export DEMO_PACK_PYTHON='python3'

# --- MySQL ---
export DEMO_MYSQL_HOST='127.0.0.1'
export DEMO_MYSQL_PORT=3306
# One schema per team keeps shared-server runs apart. Use a new name when the
# project is deployed next to an older copy; default in code is spark_project_demo.
export DEMO_MYSQL_SCHEMA='spark_project_demo_new'
export DEMO_MYSQL_SETUP_USER='root'
export DEMO_MYSQL_USER='root'
# Leave passwords unset to be prompted once per script, or to use ~/.my.cnf.
# export DEMO_MYSQL_PASSWORD=''
# export DEMO_MYSQL_SETUP_PASSWORD=''
# export DEMO_JDBC_DRIVER='com.mysql.cj.jdbc.Driver'
# export DEMO_JDBC_OPTIONS='sslMode=DISABLED'

# --- Demo dates ---
# Inclusive window used when run.sh gets no explicit dates.
export DEMO_DATE_FROM='2025-01-06'
export DEMO_DATE_TO='2025-01-31'
# Optional: reuse a fixed run id after scripts/cleanup_run.sh removed it.
# export DEMO_RUN_ID='demo_manual_01'

# --- ML ---
# Required by fund_purchase_lr and writable from the driver on this host.
export DEMO_MODEL_ROOT="file://$HOME/fund-models"
# Negatives kept per positive; 20 yields the documented 1:20 sampled test set.
# export DEMO_NEGATIVES_PER_POSITIVE=20

# --- Logs ---
# Every run writes logs/<run_id>.log and stores the path in demo_run/fund_ml_run,
# so scripts/report.sh can point back to the exact output. Nothing else to set.
